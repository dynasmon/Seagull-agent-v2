[Unit]
Description=Seagull endpoint agent
Documentation=https://github.com/dynasmon/Seagull-agent-v2#installing
After=network.target

[Service]
Type=exec
User=seagull-agent
Group=seagull-agent
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/seagull-agent -config /etc/seagull-agent/agent.json run
ExecReload=kill -HUP $MAINPID
StateDirectory=seagull-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadOnlyPaths=/run
BindReadOnlyPaths=/sys
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
InaccessiblePaths=-/dev/shm -/dev/mqueue
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=4096
MemoryMax=512M
MemorySwapMax=0
MemoryPressureWatch=off
CPUQuota=50%
TasksMax=256
Restart=on-failure
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=5min
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
