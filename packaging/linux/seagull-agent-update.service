[Unit]
Description=Seagull endpoint agent installer
Documentation=https://github.com/dynasmon/Seagull-agent-v2#updating

[Service]
Type=oneshot
ExecStart=/usr/bin/seagull-agent -config /etc/seagull-agent/agent.json update install
StateDirectory=seagull-agent-update
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
TimeoutStartSec=20min
