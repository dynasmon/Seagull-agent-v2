{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "merge"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "code analysis",
            "integration_id": 15368
          },
          {
            "context": "debian package on ubuntu 24.04",
            "integration_id": 15368
          },
          {
            "context": "debian package rebuilt by another builder",
            "integration_id": 15368
          },
          {
            "context": "every fuzz target for a few seconds",
            "integration_id": 15368
          },
          {
            "context": "failures the installed agent recovers from, on ubuntu 24.04",
            "integration_id": 15368
          },
          {
            "context": "source verification",
            "integration_id": 15368
          },
          {
            "context": "the same package from both builders",
            "integration_id": 15368
          },
          {
            "context": "vulnerability analysis",
            "integration_id": 15368
          },
          {
            "context": "what the installed agent spends, on ubuntu 24.04",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
